{
  "name": "we-pixel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:fn && npm run build:server && npm run mcp:build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "preview:sprite": "esbuild scripts/preview-sprite.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/preview-sprite.mjs --log-level=warning && node node_modules/.tmp/preview-sprite.mjs",
    "mcp:build": "esbuild mcp/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-mcp/server.mjs --log-level=warning",
    "mcp:smoke": "npm run mcp:build && node scripts/mcp-smoke.mjs",
    "test:repair": "esbuild scripts/repair-test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/repair-test.mjs --log-level=warning && node node_modules/.tmp/repair-test.mjs",
    "build:server": "esbuild server/serve.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/serve.mjs --log-level=warning",
    "start": "node dist-server/serve.mjs",
    "vercel-build": "tsc -b && vite build && npm run build:fn",
    "deploy": "npx --yes vercel@latest --prod",
    "deploy:preview": "npx --yes vercel@latest",
    "build:fn": "node scripts/build-fn.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.51",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.79",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
